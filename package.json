{
  "name": "pkcore",
  "version": "0.9.1",
  "description": "Node.js bindings for pkcore, a high-performance poker analysis library",
  "license": "MIT OR Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImperialBower/pkcore.js.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "napi": {
    "binaryName": "pkcore",
    "packageName": "@imperialbower/pkcore",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">= 20"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "demo": "node demo.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6",
    "typescript": "^5.9.0"
  }
}
